# Kopiera till .env och fyll i. .env ignoreras av git.

# Datakälla: demo | personal_api | garminconnect
# Utelämnas den används personal_api om en nyckel finns, annars demo.
# GARMIN_SOURCE=personal_api

# --- Rekommenderat: Garmins officiella Personal API ---
# Skapa nyckeln i Garmin Connect på webben (Personal API Key). Den visas bara en gång.
GARMIN_PERSONAL_API_KEY=

# --- Alternativ: garminconnect (inofficiellt, e-post + lösenord) ---
# GARMIN_SOURCE=garminconnect
# GARMIN_EMAIL=
# GARMIN_PASSWORD=
# GARMIN_TOKENSTORE=~/.garminconnect

# DB_PATH=data/garmin.db
# HOST=127.0.0.1
# PORT=8000
