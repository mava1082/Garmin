# Kopiera till .env och fyll i. .env ignoreras av git.

# Datakälla: demo | garminconnect | health_api
GARMIN_SOURCE=demo

# --- Alternativ A: garminconnect (ditt vanliga Garmin Connect-konto) ---
# Lösenordet behövs bara första gången; sedan används sparade tokens.
GARMIN_EMAIL=
GARMIN_PASSWORD=
# GARMIN_TOKENSTORE=~/.garminconnect

# --- Alternativ B: officiella Garmin Health API (Developer Program) ---
GARMIN_CONSUMER_KEY=
GARMIN_CONSUMER_SECRET=
# Fås via: python -m garmin_dashboard.health_auth
GARMIN_ACCESS_TOKEN=
GARMIN_ACCESS_TOKEN_SECRET=

# DB_PATH=data/garmin.db
# HOST=127.0.0.1
# PORT=8000
